{
  "_comment": "V3.3 canonical description codec. ONE schema for every controller family; no family gets a bespoke encoding. Frozen before benchmarks. We do NOT claim to measure Kolmogorov complexity -- this is description length under a fixed coding scheme (harness section 8).",
  "version": "1.0",
  "bits": {
    "opcode": 8,
    "integer": 32,
    "float": 64,
    "seed": 64,
    "enum": 8
  },
  "float_precision": "IEEE-754 binary64",
  "coordinate_precision": "binary64",
  "prng": "numpy.random.Generator(PCG64)",
  "shuffle_algorithm": "Generator.permutation (Fisher-Yates)",
  "opcodes": {
    "EXPLICIT_LIST": 1,
    "PROCEDURAL_SEEDED": 2,
    "PROCEDURAL_PERIODIC": 3,
    "RECURSIVE_IFS": 4,
    "EXPLICIT_WEIGHTS": 5
  },
  "energy_laws": {
    "PER_LEVEL_E0_OVER_COUNT": 1,
    "UNIFORM": 2,
    "LEARNED": 3
  },
  "fields": {
    "EXPLICIT_LIST": ["opcode", "integer:n", "float:E0", "integer:n_components", "per_component[float:a, float:b, float:e]"],
    "PROCEDURAL_SEEDED": ["opcode", "integer:n", "float:E0", "enum:energy_law", "enum:algorithm", "seed"],
    "PROCEDURAL_PERIODIC": ["opcode", "integer:n", "float:E0", "enum:energy_law"],
    "RECURSIVE_IFS": ["opcode", "integer:n", "float:E0", "enum:energy_law", "integer:b", "float:rho"],
    "EXPLICIT_WEIGHTS": ["opcode", "integer:n", "float:E0", "integer:n_weights", "per_weight[float:w]"]
  }
}
